# ==========================================
# NEXUS GAMING - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Auth0 Authentication
# Create a free tenant at https://auth0.com
# Create a "Single Page Application"
# Set Allowed Callback URLs to: http://localhost:5173, https://your-vercel-domain.vercel.app
# Set Allowed Logout URLs to: http://localhost:5173, https://your-vercel-domain.vercel.app
# Set Allowed Web Origins to: http://localhost:5173, https://your-vercel-domain.vercel.app

VITE_AUTH0_DOMAIN=your-tenant-name.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id_here

# 2. Vercel Web Analytics (Optional)
VITE_VERCEL_ANALYTICS_ENABLED=true
